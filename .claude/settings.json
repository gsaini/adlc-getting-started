{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm test *)",
			"Bash(pnpm verify)",
			"Bash(pnpm typecheck)",
			"Bash(pnpm lint)",
			"Bash(pnpm format)",
			"Bash(pnpm coverage)",
			"Bash(pnpm spec:validate)",
			"Bash(pnpm db:migrate:local)",
			"Bash(pnpm db:reset:local)",
			"Bash(pnpm exec openspec *)",
			"Bash(openspec *)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git add *)",
			"Bash(git commit *)"
		],
		"ask": [
			"Bash(pnpm add *)",
			"Bash(pnpm remove *)",
			"Bash(git push *)",
			"Bash(git checkout *)",
			"Edit(./package.json)",
			"Write(./package.json)",
			"Edit(./pnpm-workspace.yaml)",
			"Write(./pnpm-workspace.yaml)",
			"Edit(./wrangler.jsonc)",
			"Write(./wrangler.jsonc)",
			"Edit(./biome.json)",
			"Write(./biome.json)",
			"Edit(./tsconfig.json)",
			"Write(./tsconfig.json)",
			"Edit(./test/tsconfig.json)",
			"Write(./test/tsconfig.json)",
			"Edit(./CLAUDE.md)",
			"Write(./CLAUDE.md)",
			"Edit(./scripts/**)",
			"Write(./scripts/**)",
			"Edit(./.github/**)",
			"Write(./.github/**)",
			"Edit(./vitest.config.*)",
			"Write(./vitest.config.*)",
			"Edit(./vite.config.*)",
			"Write(./vite.config.*)",
			"Edit(./.npmrc)",
			"Write(./.npmrc)"
		],
		"deny": [
			"Edit(./.claude/**)",
			"Write(./.claude/**)",
			"Write(./.git/**)",
			"Edit(./.git/**)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./.dev.vars)",
			"Read(./.dev.vars.*)",
			"Bash(rm -rf *)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Read(~/.wrangler/**)",
			"Read(~/.config/.wrangler/**)",
			"Read(~/Library/Preferences/.wrangler/**)",
			"Read(~/.cloudflared/**)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\"",
						"timeout": 60
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-on-stop.mjs\"",
						"timeout": 300
					}
				]
			}
		]
	}
}
